# API/runtime config
FRONTEND_ORIGIN=http://localhost:3000
DEFAULT_RELAYS=wss://relay.damus.io,wss://nos.lol

# Example Nostr config
# Use real values only in your local .env file. Never commit real nsec/private keys.
KUBERBOLT_RELAYS=wss://relay.damus.io,wss://nos.lol
KUBERBOLT_CLIENT_NSEC=
KUBERBOLT_PROVIDER_NSEC=
KUBERBOLT_PROVIDER_PUBKEY=
KUBERBOLT_CLIENT_IDENTITY_PATH=examples/client_identity.json
KUBERBOLT_PROVIDER_IDENTITY_PATH=examples/provider_identity.json
KUBERBOLT_PROVIDER_HOST=127.0.0.1
KUBERBOLT_PROVIDER_PORT=54654
KUBERBOLT_HANDSHAKE_TIMEOUT_SECONDS=30

# Optional app integrations
GOOGLE_API_KEY=
